{
  "$schema": "https://example.com/design-system.schema.json",
  "meta": {
    "name": "Editorial Modernist System",
    "version": "1.0.0",
    "inspiration": {
      "reference": "Editorial spread with modernist grid, oversized grotesk headline, museum-label metadata rail, and annotation highlight block.",
      "keywords": [
        "midcentury modern",
        "international typographic style",
        "editorial clarity",
        "museum label",
        "asymmetric grid",
        "quiet hierarchy"
      ]
    },
    "voice": {
      "tone": ["calm", "confident", "precise", "warmly instructive"],
      "writing_rules": [
        "Prefer short, declarative sentences.",
        "Avoid hype and superlatives; let structure and content carry authority.",
        "Use factual captions; keep labels succinct.",
        "Use whitespace as punctuation."
      ]
    }
  },
  "foundations": {
    "grid": {
      "system": "12-column",
      "container": {
        "maxWidthPx": 1200,
        "gutterPx": 24,
        "marginPx": 24
      }
    },
    "spacing": {
      "scalePx": {
        "0": 0,
        "1": 4,
        "2": 8,
        "3": 12,
        "4": 16,
        "5": 24,
        "6": 32,
        "7": 48,
        "8": 64,
        "9": 96,
        "10": 128
      },
      "baselinePx": 4
    },
    "radii": {
      "none": 0,
      "sm": 6,
      "md": 12,
      "lg": 16,
      "pill": 999
    },
    "elevation": {
      "shadows": {
        "none": "none",
        "sm": "0 2px 10px rgba(0,0,0,0.08)",
        "md": "0 10px 30px rgba(0,0,0,0.12)",
        "lg": "0 18px 50px rgba(0,0,0,0.14)"
      }
    },
    "color": {
      "modes": ["light"],
      "palette": {
        "paper": {
          "base": "#FFFFFF",
          "soft": "#F3F4F6"
        },
        "ink": {
          "primary": "#111111",
          "secondary": "#3C3C3C",
          "muted": "#6B7280"
        },
        "lines": {
          "hairline": "#E5E7EB",
          "divider": "#D1D5DB"
        },
        "surface": {
          "panel": "#EFEFEF",
          "card": "#FFFFFF"
        },
        "brand": {
          "modernistBlue": "#406BB4",
          "annotationYellow": "#D7D106"
        },
        "states": {
          "focusRing": "#406BB4",
          "success": "#16A34A",
          "warning": "#D97706",
          "danger": "#DC2626",
          "info": "#2563EB"
        }
      }
    },
    "typography": {
      "fonts": {
        "sans": {
          "name": "Inter",
          "fallbacks": ["Helvetica Neue", "Helvetica", "Arial", "system-ui", "sans-serif"]
        },
        "serif": {
          "name": "Georgia",
          "fallbacks": ["Times New Roman", "Times", "serif"]
        }
      },
      "scale": {
        "display": { "sizePx": 72, "lineHeight": 1.0, "weight": 800, "trackingEm": -0.02 },
        "h1": { "sizePx": 56, "lineHeight": 1.05, "weight": 800, "trackingEm": -0.02 },
        "h2": { "sizePx": 36, "lineHeight": 1.15, "weight": 750, "trackingEm": -0.015 },
        "h3": { "sizePx": 28, "lineHeight": 1.2, "weight": 700, "trackingEm": -0.01 },
        "h4": { "sizePx": 20, "lineHeight": 1.25, "weight": 650, "trackingEm": -0.005 },
        "bodyLg": { "sizePx": 18, "lineHeight": 1.6, "weight": 450, "trackingEm": 0 },
        "body": { "sizePx": 16, "lineHeight": 1.6, "weight": 450, "trackingEm": 0 },
        "caption": { "sizePx": 13, "lineHeight": 1.4, "weight": 450, "trackingEm": 0.01 },
        "label": { "sizePx": 12, "lineHeight": 1.2, "weight": 600, "trackingEm": 0.08, "transform": "uppercase" }
      }
    },
    "motion": {
      "durationsMs": { "fast": 120, "base": 200, "slow": 320 },
      "easing": {
        "standard": "cubic-bezier(0.2, 0, 0, 1)",
        "exit": "cubic-bezier(0.4, 0, 1, 1)"
      }
    }
  }
}
