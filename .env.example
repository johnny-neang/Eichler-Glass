# Copy to .env for local development. In production, set these in the
# Vercel dashboard (Project → Settings → Environment Variables).

# Postgres connection string.
# Local dev: your own Postgres. Production: Vercel Postgres provides this
# automatically as DATABASE_URL once the store is linked to the project.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password for the admin leads dashboard (/admin/leads). Required for
# /api/admin/login and GET /api/leads to work.
ADMIN_PASSWORD=change-me

# Mailjet credentials for lead-notification emails.
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MJ_SENDER_EMAIL=hello@eichlerglass.com
